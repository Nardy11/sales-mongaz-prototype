{
  "name": "sales-mongaz-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "api:dev": "tsx watch api/src/server.ts",
    "api:start": "tsx api/src/server.ts",
    "api:migrate": "tsx api/db/migrate.ts",
    "api:bootstrap": "tsx api/db/bootstrap.ts",
    "api:seed-phase1": "tsx api/db/seed-phase1.ts",
    "api:seed-phase2": "tsx api/db/seed-phase2.ts",
    "api:seed-phase3": "tsx api/db/seed-phase3.ts",
    "api:seed-phase4": "tsx api/db/seed-phase4.ts",
    "api:seed-phase5": "tsx api/db/seed-phase5.ts",
    "api:seed-phase6": "tsx api/db/seed-phase6.ts",
    "api:seed-phase7": "tsx api/db/seed-phase7.ts",
    "test:api:phase7": "node --import tsx --test api/tests/phase7-reporting.pg.ts",
    "test:api": "node --import tsx --test api/tests/*.test.ts",
    "test:api:phase2": "node --import tsx --test api/tests/phase2-postgres.pg.ts",
    "test:api:phase3": "node --import tsx --test api/tests/phase3-postgres.pg.ts",
    "test:api:phase4": "node --import tsx --test --test-concurrency=1 api/tests/phase4-order.pg.ts api/tests/phase4-complaint.pg.ts",
    "test:api:phase5": "node --import tsx --test api/tests/phase5-supervisor.pg.ts",
    "test:api:phase6": "node --import tsx --test api/tests/phase6-manager.pg.ts",
    "test:e2e:phase2": "playwright test tests/phase2-representative.spec.ts",
    "test:e2e:phase3": "playwright test tests/phase3-telesales.spec.ts",
    "test:e2e:phase4": "playwright test tests/phase4-lifecycle.spec.ts",
    "test:e2e:phase5": "playwright test tests/phase5-supervisor.spec.ts",
    "test:e2e:phase6": "playwright test tests/phase6-manager.spec.ts",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fontsource/roboto": "5.2.10",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@tanstack/react-query": "^5.101.4",
    "@use-gesture/react": "10.3.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.1",
    "motion": "12.42.2",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.86.0",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
